<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.intentreactor</groupId>
        <artifactId>intent-reactor-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>intent-reactor-api</artifactId>
    <name>IntentReactor API</name>
    <description>Public API contracts: interfaces, model classes, and application events.
        The only compile dependency needed by third-party Tool and Planner implementations.
    </description>

    <url>https://github.com/VladimirLushin/intent-reactor-framework-spring-ai-2</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Vladimir Lushin</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/VladimirLushin/intent-reactor-framework-spring-ai-2.git</connection>
        <developerConnection>scm:git:ssh://github.com/VladimirLushin/intent-reactor-framework-spring-ai-2.git</developerConnection>
        <url>https://github.com/VladimirLushin/intent-reactor-framework-spring-ai-2</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <!--
          spring-context provides ApplicationEvent, which IntentReactorEvent extends.
          Using spring-context directly (not spring-boot-starter) so that plain
          Spring Framework projects (not Spring Boot) can depend on this module.
          Version is managed by spring-boot-dependencies BOM in the parent.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!--
          SessionState, Message, ToolResult etc. are Jackson-serializable POJOs.
          Jackson 3 (tools.jackson) databind handles java.time (LocalDateTime) natively.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

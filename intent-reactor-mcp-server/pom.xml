<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.intentreactor</groupId>
        <artifactId>intent-reactor-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>intent-reactor-mcp-server</artifactId>
    <name>IntentReactor MCP Server</name>
    <description>Exposes IntentReactor Tool beans and/or the planning pipeline as an MCP server</description>

    <url>https://github.com/VladimirLushin/intent-reactor-framework-spring-ai-2</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Vladimir Lushin</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/VladimirLushin/intent-reactor-framework-spring-ai-2.git</connection>
        <developerConnection>scm:git:ssh://github.com/VladimirLushin/intent-reactor-framework-spring-ai-2.git</developerConnection>
        <url>https://github.com/VladimirLushin/intent-reactor-framework-spring-ai-2</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <!-- Public contracts only -->
        <dependency>
            <groupId>com.intentreactor</groupId>
            <artifactId>intent-reactor-api</artifactId>
        </dependency>
        <!-- provided: compile-only for @AutoConfigureAfter(IntentReactorAutoConfiguration.class) -->
        <dependency>
            <groupId>com.intentreactor</groupId>
            <artifactId>intent-reactor-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring AI MCP (ToolCallback, ToolCallbackProvider, McpSchema etc.) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp</artifactId>
        </dependency>

        <!-- WebMVC transport — optional; user must add spring-ai-starter-mcp-server-webmvc -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>mcp-spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- DispatcherServlet for @ConditionalOnWebApplication(SERVLET) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
